{
  "name": "@knocklabs/mcp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "scripts": {
    "build:client": "cd client && npm ci && npm run build",
    "build": "npm run build:client && npm run cf-typegen && tsc -p .",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build:client && wrangler deploy",
    "dev": "wrangler dev",
    "inspector": "mcp-inspector --config mcp-inspector.json",
    "dev:client": "cd client && npm run dev",
    "start": "wrangler dev",
    "type-check": "npm run cf-typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"client/src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.3.8",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@knocklabs/agent-toolkit": "^0.5.7",
    "@knocklabs/mgmt": "^0.35.0",
    "@knocklabs/node": "^1.32.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@posthog/mcp": "0.21.2",
    "@sentry/cloudflare": "^10.49.0",
    "agents": "^0.8.7",
    "better-result": "^2.9.2",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "posthog-node": "5.55.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@knocklabs/agent-toolkit": {
      "@knocklabs/mgmt": "$@knocklabs/mgmt",
      "@knocklabs/node": "$@knocklabs/node",
      "@sentry/node": "10.77.1"
    },
    "agents": {
      "@modelcontextprotocol/sdk": "1.32.2"
    },
    "yargs": "18.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "zod": "4.6.7",
    "fast-uri": "3.1.9",
    "qs": "6.17.0",
    "ip-address": "10.7.5",
    "proxy-addr": "2.0.8",
    "lodash": "4.18.1",
    "body-parser": "2.4.0",
    "raw-body": "4.0.0",
    "@hono/node-server": "2.1.5",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/instrumentation-knex": "0.68.0",
    "@opentelemetry/instrumentation-tedious": "0.43.0",
    "@opentelemetry/instrumentation-mongoose": "0.70.0",
    "@opentelemetry/instrumentation-mysql": "0.70.0",
    "@opentelemetry/instrumentation-mysql2": "0.70.0",
    "@opentelemetry/instrumentation-pg": "0.77.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260527.1",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3",
    "wrangler": "^4.95.0"
  }
}
